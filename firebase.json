{
  "hosting": {
    "public": ".firebase-public",
    "predeploy": ["node scripts/build-public.cjs"],
    "headers": [{ "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "firestore.rules",
      "firestore.indexes.json",
      "seed-data.sample.json",
      ".firebaserc.example",
      "functions/**",
      "scripts/**",
      "tests/**",
      "preview-server.cjs",
      "package*.json",
      "DEPLOYMENT.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
