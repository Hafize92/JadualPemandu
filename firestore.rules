rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "Bg6iUrQS9cg4irQ3QAtG5VFDR8E2"
        && request.auth.token.email == "mhafize@jkr.gov.my";
    }

    function isSupervisor() {
      return signedIn() && profile().role == "supervisor"
        && profile().get("disabled", false) == false
        && profile().get("mustChangePassword", false) == false;
    }

    function assignedByList(vehicleId) {
      return profile().allowedVehicleIds is list
        && vehicleId in profile().allowedVehicleIds;
    }

    function canWriteBooking(vehicleId) {
      return isAdmin()
        || (isSupervisor() && assignedByList(vehicleId));
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if canWriteBooking(request.resource.data.vehicleId);
      allow update: if isAdmin()
        || (
          isSupervisor()
          && canWriteBooking(resource.data.vehicleId)
          && request.resource.data.vehicleId == resource.data.vehicleId
        );
      allow delete: if canWriteBooking(resource.data.vehicleId);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /accountAudit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
