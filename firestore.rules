rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/access/$(request.auth.token.email)).data;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "Bg6iUrQS9cg4irQ3QAtG5VFDR8E2"
        && request.auth.token.email == "mhafize@jkr.gov.my";
    }

    function isSupervisor() {
      return signedIn() && request.auth.token.email_verified == true
        && profile().role == "supervisor" && profile().disabled == false;
    }

    function assignedByList(vehicleId) {
      return profile().allowedVehicleIds is list
        && vehicleId in profile().allowedVehicleIds
        && get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.supervisorEmail == request.auth.token.email;
    }

    function canWriteBooking(vehicleId) {
      return isAdmin()
        || (isSupervisor() && assignedByList(vehicleId));
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if canWriteBooking(request.resource.data.vehicleId);
      allow update: if isAdmin()
        || (
          isSupervisor()
          && canWriteBooking(resource.data.vehicleId)
          && request.resource.data.vehicleId == resource.data.vehicleId
        );
      allow delete: if canWriteBooking(resource.data.vehicleId);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /access/{email} {
      allow read: if isAdmin() || (signedIn()
        && request.auth.token.email_verified == true && request.auth.token.email == email);
      allow create, update: if isAdmin() && email != "mhafize@jkr.gov.my"
        && request.resource.data.email == email
        && request.resource.data.role == "supervisor"
        && request.resource.data.disabled is bool
        && request.resource.data.allowedVehicleIds is list
        && request.resource.data.allowedVehicleIds.size() <= 30;
      allow delete: if isAdmin() && email != "mhafize@jkr.gov.my";
    }
  }
}
